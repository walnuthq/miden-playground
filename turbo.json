{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "api#build": {
      "env": [
        "NODE_ENV",
        "NEXT_PHASE",
        "WEB_URL",
        "API_COMPILE_URL",
        "API_REGISTRY_URL",
        "PACKAGES_PATH",
        "DATABASE_URL"
      ]
    },
    "web#build": {
      "env": ["NODE_ENV", "NEXT_PUBLIC_API_URL"]
    },
    "status-page#build": {
      "cache": false,
      "outputs": ["dist/**"],
      "env": ["WEB_URL", "API_URL", "STATUS_PAGE_BASE", "STATUS_PAGE_URL"]
    },
    "status-page#notify": {
      "cache": false,
      "env": ["SLACK_WEBHOOK_URL", "STATUS_PAGE_URL", "GITHUB_*"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
