# Local overrides: copy to .env.local, read by `next dev` and `next build`.
# Every variable is optional: unset ones fall back to the local values in
# lib/constants.ts, or disable the feature (Para, analytics).
# Production values: .env.production (all of them are inlined at build time).
# Keep in sync with .env.production, process-env.d.ts and the
# `miden-playground-web#build` env list in turbo.json.

# API app (apps/api).
# NEXT_PUBLIC_API_URL=http://localhost:3001
# Miden package registry.
# NEXT_PUBLIC_API_REGISTRY_URL=http://localhost:8081
# Miden Guardian, used by the wallet backup tutorial.
# NEXT_PUBLIC_GUARDIAN_ENDPOINT_URL=http://localhost:3002

# Para embedded wallets. Para is disabled when the API key is unset.
# NEXT_PUBLIC_PARA_API_KEY=
# BETA | PROD | SANDBOX | DEV, defaults to BETA.
# NEXT_PUBLIC_PARA_ENVIRONMENT=BETA

# Amount (in base units) requested from the faucet to pay transaction fees.
# Defaults to the faucet's base amount.
# NEXT_PUBLIC_MIDEN_FEE_AMOUNT=

# Simple Analytics: domain the tracking script and events are proxied for.
# Analytics is disabled when unset. Pageviews are reported under the domain the
# app is served on.
# SIMPLE_ANALYTICS_HOSTNAME=playground.miden.xyz
