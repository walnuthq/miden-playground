# Copy to .env.local (or .env.development.local / .env.production.local).
# Every variable is optional: unset ones fall back to the defaults below.
# Keep in sync with process-env.d.ts and the `web#build` env list in turbo.json.

# API app (apps/api).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Miden package registry.
NEXT_PUBLIC_API_REGISTRY_URL=http://localhost:8081
# Miden Guardian, used by the wallet backup tutorial.
NEXT_PUBLIC_GUARDIAN_ENDPOINT_URL=http://localhost:3002

# Para embedded wallets. Para is disabled when the API key is unset.
# NEXT_PUBLIC_PARA_API_KEY=
# BETA | PROD | SANDBOX | DEV, defaults to BETA.
# NEXT_PUBLIC_PARA_ENVIRONMENT=BETA

# Amount (in base units) requested from the faucet to pay transaction fees.
# Defaults to the faucet's base amount.
# NEXT_PUBLIC_MIDEN_FEE_AMOUNT=
