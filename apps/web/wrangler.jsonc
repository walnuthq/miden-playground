{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker/index.ts",
  "name": "miden-playground",
  "preview_urls": true,
  // playground.miden.xyz is proxied by Vercel to the workers.dev URL, which
  // wrangler disables when routes are declared unless this is set.
  "workers_dev": true,
  // Deploys attach the custom domains listed here and detach any other.
  "routes": [
    { "pattern": "miden-playground.walnut.dev", "custom_domain": true },
  ],
  "compatibility_date": "2025-09-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // The Vite build. Unknown paths get index.html, for the client-side router.
  // Only the Simple Analytics paths run the Worker, everything else is served
  // straight from the assets.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/proxy.js", "/auto-events.js", "/simple/*"],
  },
  "vars": {
    // Simple Analytics: domain the tracking script and events are proxied for
    // (worker/index.ts). Pageviews are reported under the domain the app is
    // served on. Emptied in .dev.vars for local `wrangler dev`.
    "SIMPLE_ANALYTICS_HOSTNAME": "playground.miden.xyz",
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
