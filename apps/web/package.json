{
  "name": "miden-playground-web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p worker --noEmit",
    "preview": "vite build && wrangler dev",
    "deploy-staging": "vite build && wrangler deploy --env staging",
    "deploy": "vite build && wrangler deploy",
    "upload": "vite build && wrangler versions upload",
    "cf-typegen": "wrangler types --include-runtime=false worker/worker-configuration.d.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@getpara/evm-wallet-connectors": "3.24.0",
    "@getpara/react-sdk-lite": "3.24.0",
    "@getpara/web-sdk": "3.24.0",
    "@miden-sdk/miden-sdk": "0.17.6",
    "@miden-sdk/miden-wallet-adapter": "0.17.6",
    "@miden-sdk/para": "0.17.6",
    "@miden-sdk/para-react": "0.17.6",
    "@miden-sdk/react": "0.17.6",
    "@monaco-editor/react": "4.7.0",
    "@opentelemetry/api": "1.9.1",
    "@openzeppelin/miden-multisig-client": "0.18.3",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-table": "9.3.1",
    "@wagmi/core": "3.6.7",
    "@workspace/ui": "workspace:*",
    "lodash": "4.18.1",
    "lucide-react": "1.61.0",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.15.0",
    "react-router": "8.5.0",
    "smol-toml": "1.9.1",
    "sonner": "2.0.8",
    "usehooks-ts": "3.1.1",
    "uuid": "14.0.3",
    "viem": "2.57.11",
    "wagmi": "3.7.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "@miden-sdk/vite-plugin": "0.17.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/lodash": "4.17.27",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@workspace/typescript-config": "workspace:*",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-node-polyfills": "0.28.0",
    "wrangler": "4.152.0"
  }
}
