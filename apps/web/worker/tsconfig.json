{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["*.ts"]
}
