{
  "name": "status-page",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "probe": "tsx scripts/probe.ts",
    "notify": "tsx scripts/notify.ts",
    "build": "pnpm probe && pnpm typecheck && vite build",
    "dev": "pnpm probe && vite",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@workspace/ui": "workspace:*",
    "lucide-react": "1.60.0",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "18.0.8",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
