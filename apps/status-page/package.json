    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "playwright": "1.63.0",
    "tsx": "4.23.13",
