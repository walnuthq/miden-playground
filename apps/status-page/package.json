{
  "name": "status-page",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "probe": "node scripts/probe.ts",
    "notify": "node scripts/notify.ts",
    "build": "pnpm probe && pnpm typecheck && vite build",
    "dev": "pnpm probe && vite",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@workspace/ui": "workspace:*",
    "lucide-react": "1.67.0",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@workspace/typescript-config": "workspace:*",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
