# Local overrides: copy to .env.local, read by the probe and notify scripts and
# by vite.config.ts.
# Every variable is optional: unset ones fall back to the local values in
# scripts/probe.ts and vite.config.ts, or disable the feature (Slack).
# Production values: `env` of .github/workflows/deploy-status-page.yml, with
# SLACK_WEBHOOK_URL as a repository secret.
# Keep in sync with process-env.d.ts and the `status-page#*` env lists in
# turbo.json.

# Services probed at build time by scripts/probe.ts.
# WEB_URL=http://localhost:3000
# API_URL=http://localhost:3001

# Where the last published snapshot lives: the probe reads it to work out what
# changed since the previous run. Derived from the repository in CI. Locally,
# leave it unset and every run starts without previous state.
# STATUS_PAGE_URL=https://walnuthq.github.io/miden-playground/

# Slack Incoming Webhook. Unset means scripts/notify.ts prints and posts nothing.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/…

# Vite `base`: the path the page is served from.
# STATUS_PAGE_BASE=/miden-playground/
