# Copy to .env.
# Keep in sync with process-env.d.ts and the `status-page#*` env lists in turbo.json.

# Services probed at build time by scripts/probe.ts. In CI these come from the
# repository variables of the same name (see
# .github/workflows/deploy-status-page.yml).
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# Where the last published snapshot lives — the probe reads it to work out what
# changed since the previous run. Derived from the repository in CI; leave unset
# locally and every run simply starts without previous state.
# STATUS_PAGE_URL=https://walnuthq.github.io/miden-playground/

# Slack Incoming Webhook. Unset means scripts/notify.ts prints and posts nothing.
# In CI this is a repository *secret*, not a variable.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/…

# Vite `base`: the path the page is served from.
# STATUS_PAGE_BASE=/miden-playground/
