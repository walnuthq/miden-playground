{
  "name": "miden-playground-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 3001",
    "build": "wrangler deploy --dry-run --outdir dist --env production",
    "deploy": "wrangler deploy --env production",
    "lint": "oxlint && oxfmt --check",
    "format": "oxlint --fix && oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'lib/**/*.test.ts'",
    "cf-typegen": "wrangler types --env-file .env.example --strict-vars=false cloudflare-env.d.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "templates:check": "node scripts/check-templates.ts"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.6",
    "fflate": "0.8.3",
    "hono": "4.13.22",
    "pg": "8.23.1",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.11",
    "@types/pg": "8.23.1",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "1.0.0-rc.6",
    "typescript": "7.0.2",
    "wrangler": "4.168.0"
  }
}
