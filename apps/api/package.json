{
  "name": "miden-playground-api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port 3001",
    "build": "wrangler deploy --dry-run --outdir dist --env production",
    "deploy": "wrangler deploy --env production",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-file .env.example --strict-vars=false cloudflare-env.d.ts",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.4",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "lodash": "4.18.1",
    "pg": "8.23.1",
    "smol-toml": "1.9.1",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@types/lodash": "4.17.26",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "18.0.8",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "7.0.2",
    "wrangler": "4.151.3"
  }
}
