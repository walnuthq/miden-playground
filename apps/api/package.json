{
  "name": "miden-playground-api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port 3001",
    "build": "wrangler deploy --dry-run --outdir dist --env production",
    "deploy": "wrangler deploy --env production",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-file .env.example --strict-vars=false cloudflare-env.d.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "examples:compile": "node scripts/compile-examples.ts",
    "templates:check": "node scripts/check-lockfile.ts && node scripts/check-templates.ts",
    "lockfile:check": "node scripts/check-lockfile.ts",
    "lockfile:sync": "node scripts/check-lockfile.ts --write"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.5",
    "fflate": "0.8.3",
    "hono": "4.13.16",
    "pg": "8.23.1",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "1.0.0-rc.5",
    "typescript": "7.0.2",
    "wrangler": "4.158.0"
  }
}
