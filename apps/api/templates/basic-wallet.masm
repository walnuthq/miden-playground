# A basic wallet: an account component that receives assets and sends them
# in notes.
#
# Each procedure is the standard wallet's (miden::standards::wallets::basic),
# instruction for instruction. A procedure is known by its MAST root, a hash
# of its code, so these have the same roots as the SDK's, Bread's and Para's
# wallets: a note written for a standard wallet, such as P2ID, can be
# consumed by an account built with this component, and the other way round.

use {Asset, NoteRecipient, NoteTag, NoteType} from miden::protocol::types
use miden::protocol::native_account
use miden::protocol::output_note

#! Adds `asset` to the account's vault.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE, pad(8)]
#! Outputs: [pad(16)]
#!
#! Panics if the same non-fungible asset is already in the vault, or if adding
#! a fungible asset would take its amount above 2^63.
@account_procedure
pub proc receive_asset(asset: Asset)
    exec.native_account::add_asset
    # => [FINAL_ASSET_VALUE, pad(12)]

    # the vault's new value for this asset isn't needed
    dropw
    # => [pad(16)]
end

#! Removes `asset` from the account's vault and adds it to the output note at
#! `note_idx`.
#!
#! Inputs:  [ASSET_ID, ASSET_VALUE, note_idx, pad(7)]
#! Outputs: [pad(16)]
#!
#! Panics if the vault doesn't hold the asset, or holds less of a fungible
#! asset than `asset` names.
@account_procedure
pub proc move_asset_to_note(asset: Asset, note_idx: u16)
    # copy the asset: removing it from the vault consumes one copy
    dupw.1 dupw.1
    # => [ASSET_ID, ASSET_VALUE, ASSET_ID, ASSET_VALUE, note_idx, pad(7)]

    exec.native_account::remove_asset
    dropw
    # => [ASSET_ID, ASSET_VALUE, note_idx, pad(7)]

    # add the other copy to the note
    exec.output_note::add_asset
    # => [pad(16)]
end

#! Creates an output note and returns its index.
#!
#! Only an account procedure may create a note, so a note or transaction
#! script creates its notes by calling this one.
#!
#! Inputs:  [tag, note_type, RECIPIENT, pad(10)]
#! Outputs: [note_idx, pad(15)]
@account_procedure
pub proc create_note(tag: NoteTag, note_type: NoteType, recipient: NoteRecipient) -> u16
    exec.output_note::create
    # => [note_idx, pad(15)]
end
