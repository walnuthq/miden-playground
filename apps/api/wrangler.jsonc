{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miden-playground-api",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat fills `process.env` from vars and secrets (read by
  // lib/constants.ts) and provides the Node APIs `pg` needs.
  // enable_request_signal aborts `request.signal` when the client disconnects,
  // which cancels the upstream compile/verify calls it is passed to.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  // Production values. `wrangler dev` overrides them with .dev.vars (copied
  // from .env.example), which points at the local services.
  "vars": {
    "WEB_URL": "https://playground.miden.xyz",
    "API_COMPILE_URL": "https://miden-source-code-verification-api-compile.walnut.dev",
    "API_REGISTRY_URL": "https://miden-source-code-verification-api-registry.walnut.dev",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // `miden-playground-api` (caching disabled: the API reads back what it
      // just wrote, sslmode=require).
      "id": "27b933dd0e7c47bf9a29803a28b62b85",
      // The postgres service in docker-compose.yml.
      "localConnectionString": "postgres://miden-playground:miden_playground_dev_password@localhost:5432/miden-playground",
    },
  ],
  // Bundle the Rust templates and project files as strings (lib/templates.ts).
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.rs", "**/*.toml", "**/*.lock"],
      "fallthrough": true,
    },
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
  },
}
