# Local defaults, committed. Override them in .env.local (see .env.example):
# variables already set in the shell win over both files.
# Read by `wrangler dev` (which loads .env then .env.local) and drizzle-kit
# (drizzle.config.ts). Production doesn't read this file: the deployed Worker
# connects through its Hyperdrive binding (`env.production` in wrangler.jsonc).

# The postgres service in docker-compose.yml.
DATABASE_URL=postgres://miden-playground:miden_playground_dev_password@localhost:5432/miden-playground

# Points the HYPERDRIVE binding at DATABASE_URL in `wrangler dev`: Hyperdrive
# doesn't run locally, so the Worker connects to this database directly.
# Wrangler expands ${...}; drizzle-kit ignores this variable.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=${DATABASE_URL}
