# Copy to .env.local.
# Keep in sync with process-env.d.ts and the `api#build` env list in turbo.json.

# Web app (apps/web), allowed by CORS.
WEB_URL="http://localhost:3000"
# Where compiled packages are written.
PACKAGES_PATH="/tmp"
# Miden compiler service.
API_COMPILE_URL="http://localhost:8080"
# Miden package registry.
API_REGISTRY_URL="http://localhost:8081"
# Required.
DATABASE_URL="postgres://postgres:password@localhost:5432/postgres"
