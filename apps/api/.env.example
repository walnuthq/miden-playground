# Local overrides: copy to .env.local, read by `wrangler dev` and drizzle-kit.
# Every variable is optional: unset ones fall back to the local values in
# wrangler.jsonc (`vars`), or to .env for DATABASE_URL.
# Production values: `env.production` in wrangler.jsonc.
# Keep in sync with wrangler.jsonc and cloudflare-env.d.ts (`pnpm cf-typegen`).
# Don't add a .dev.vars file: wrangler ignores .env files when one exists.

# Web app (apps/web), allowed by CORS.
# WEB_URL=http://localhost:3000
# Miden compiler service.
# API_COMPILE_URL=http://localhost:8080
# Miden package registry.
# API_REGISTRY_URL=http://localhost:8081

# Local database, used by drizzle-kit (`pnpm db:push`) and by the Worker's
# HYPERDRIVE binding in `wrangler dev` (see .env). Defaults to the postgres
# service in docker-compose.yml.
# DATABASE_URL=postgres://miden-playground:miden_playground_dev_password@localhost:5432/miden-playground
