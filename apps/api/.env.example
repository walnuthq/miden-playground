# Copy to .dev.vars, read by `wrangler dev` and drizzle-kit. In production,
# set the first three as variables of the Worker in the Cloudflare dashboard.
# Keep in sync with worker-configuration.d.ts (`pnpm cf-typegen`).

# Web app (apps/web), allowed by CORS.
WEB_URL="http://localhost:3000"
# Miden compiler service.
API_COMPILE_URL="http://localhost:8080"
# Miden package registry.
API_REGISTRY_URL="http://localhost:8081"
# Only used by drizzle-kit (`pnpm db:push`): the Worker connects through its
# HYPERDRIVE binding, which `wrangler dev` points at the postgres service of
# docker-compose.yml (`localConnectionString` in wrangler.jsonc).
DATABASE_URL="postgres://miden-playground:miden_playground_dev_password@localhost:5432/miden-playground"
